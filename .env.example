# Data mode: placeholder | live
NEXT_PUBLIC_DATA_MODE=placeholder

# Site
NEXT_PUBLIC_SITE_URL=https://poolpilot.xyz
NEXT_PUBLIC_EXPLORER=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WalletConnect (optional — injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Pool Pilot protocol contracts.
# These remain blank until the Pool Pilot Solidity contracts are deployed and verified.
NEXT_PUBLIC_BOOK_FACTORY=
NEXT_PUBLIC_SEAT_VAULT=
NEXT_PUBLIC_SEAT_NFT=
NEXT_PUBLIC_PROTOCOL_TREASURY=

# Official Uniswap v3 deployments on Robinhood Chain (4663).
# The app has these defaults, so these variables are optional overrides.
NEXT_PUBLIC_UNISWAP_V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
NEXT_PUBLIC_SWAP_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
NEXT_PUBLIC_POSITION_MANAGER=0x73991a25c818bf1f1128deaab1492d45638de0d3

# MCFL token
NEXT_PUBLIC_MCFL_TOKEN=0x21A91215fbFc4fc002B07cc87698A6fC01Aed523
